// Keyboard layouts for Canada.

default partial
xkb_symbols "fr" {
    name[Group1] = "French (Canada)";

    key <TLDE>  {[  numbersign,         bar                                 ]};
    key <AE01>  {[  exclam,             1                                   ]};
    key <AE02>  {[  quotedbl,           2                                   ]};
    key <AE03>  {[  ccedilla,           3,                  Ccedilla        ]};
    key <AE04>  {[  dollar,             4                                   ]};
    key <AE05>  {[  percent,            5                                   ]};
    key <AE06>  {[  question,           6                                   ]};
    key <AE07>  {[  agrave,             7,                  Agrave          ]};
    key <AE08>  {[  asterisk,           8                                   ]};
    key <AE09>  {[  parenleft,          9                                   ]};
    key <AE10>  {[  parenright,         0                                   ]};
    key <AE11>  {[  minus,              underscore                          ]};
    key <AE12>  {[  equal,              plus                                ]};

    key <AD01>  {[  q,                  Q,                  questiondown    ]};
    key <AD02>  {[  w,                  W,                  backslash       ]};
    key <AD03>  {[  f,                  F,                  at              ]};
    key <AD04>  {[  p,                  P,                  asciitilde      ]};
    key <AD05>  {[  g,                  G,                  emdash          ]};
    key <AD06>  {[  j,                  J,                  yen             ]};
    key <AD07>  {[  l,                  L                                   ]};
    key <AD08>  {[  u,                  U                                   ]};
    key <AD09>  {[  y,                  Y,                  section         ]};
    key <AD10>  {[  semicolon,          colon,              paragraph       ]};
    key <AD11>  {[  dead_circumflex,    dead_diaeresis                      ]};
    key <AD12>  {[  slash,              question                            ]};

    key <AC01>  {[  a,                  A,                  oe, OE          ]};
    key <AC02>  {[  r,                  R,                  bracketleft     ]};
    key <AC03>  {[  s,                  S,                  bracketright    ]};
    key <AC04>  {[  t,                  T,                  braceleft       ]};
    key <AC05>  {[  d,                  D,                  braceright      ]};
    key <AC06>  {[  h,                  H                                   ]};
    key <AC07>  {[  n,                  N                                   ]};
    key <AC08>  {[  e,                  E                                   ]};
    key <AC09>  {[  i,                  I                                   ]};
    key <AC10>  {[  o,                  O                                   ]};
    key <AC11>  {[  eacute,             Eacute                               ]};
    key <BKSL>  {[  less,               greater                             ]};

    key <AB01>  {[  z,                  Z,                  guillemotleft   ]};
    key <AB02>  {[  x,                  X,                  guillemotright  ]};
    key <AB03>  {[  c,                  C,                  degree          ]};
    key <AB04>  {[  v,                  V,                  dead_tilde      ]};
    key <AB05>  {[  b,                  B,                  nobreakspace    ]};
    key <AB06>  {[  k,                  K                                   ]};
    key <AB07>  {[  m,                  M,                  mu              ]};
    key <AB08>  {[  comma,              apostrophe,         dead_macron     ]};
    key <AB09>  {[  period,             ampersand,          hyphen          ]};
    key <AB10>  {[  egrave,             Egrave                              ]};

    key <SPCE>  {[  space,              space                               ]};
    key <CAPS>  {[  Escape,             Escape                              ]};

    include "level3(ralt_switch)"
};
