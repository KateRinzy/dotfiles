// Keyboard layouts for Canada.

default partial
xkb_symbols "fr" {
    name[Group1] = "French (Canada)";

    key <TLDE>  {[  numbersign,         bar                                 ]};
    key <AE01>  {[  slash,              1                                   ]};
    key <AE02>  {[  parenleft,          2                                   ]};
    key <AE03>  {[  bracketleft,        3                                   ]};
    key <AE04>  {[  braceleft,          4                                   ]};
    key <AE05>  {[  apostrophe,         5                                   ]};
    key <AE06>  {[  dollar,             6                                   ]};
    key <AE07>  {[  exclam,             7                                   ]};
    key <AE08>  {[  braceright,         8                                   ]};
    key <AE09>  {[  bracketright,       9                                   ]};
    key <AE10>  {[  parenright,         0                                   ]};
    key <AE11>  {[  minus,              underscore                          ]};
    key <AE12>  {[  equal,              plus                                ]};

    key <AD01>  {[  q,                  Q,                  oe, OE          ]};
    key <AD02>  {[  w,                  W,                  backslash       ]};
    key <AD03>  {[  f,                  F,                  at              ]};
    key <AD04>  {[  p,                  P,                  asciitilde      ]};
    key <AD05>  {[  g,                  G,                  emdash          ]};
    key <AD06>  {[  j,                  J,                  yen             ]};
    key <AD07>  {[  l,                  L                                   ]};
    key <AD08>  {[  u,                  U                                   ]};
    key <AD09>  {[  y,                  Y,                  section         ]};
    key <AD10>  {[  semicolon,          colon,              paragraph       ]};
    key <AD11>  {[  dead_circumflex,    dead_diaeresis                      ]};
    key <AD12>  {[  ccedilla,           Ccedilla                            ]};
    key <BKSL>  {[  less,               greater                             ]};

    key <AC01>  {[  a,                  A,                  percent         ]};
    key <AC02>  {[  r,                  R,                  percent         ]};
    key <AC03>  {[  s,                  S,                  asterisk        ]};
    key <AC04>  {[  t,                  T,                  asciicircum     ]};
    key <AC05>  {[  d,                  D                                   ]};
    key <AC06>  {[  h,                  H                                   ]};
    key <AC07>  {[  n,                  N                                   ]};
    key <AC08>  {[  e,                  E                                   ]};
    key <AC09>  {[  i,                  I                                   ]};
    key <AC10>  {[  o,                  O                                   ]};
    key <AC11>  {[  dead_grave,         question                            ]};

    key <AB01>  {[  z,                  Z,                  guillemotleft   ]};
    key <AB02>  {[  x,                  X,                  guillemotright  ]};
    key <AB03>  {[  c,                  C,                  degree          ]};
    key <AB04>  {[  v,                  V,                  dead_tilde      ]};
    key <AB05>  {[  b,                  B,                  nobreakspace    ]};
    key <AB06>  {[  k,                  K                                   ]};
    key <AB07>  {[  m,                  M,                  mu              ]};
    key <AB08>  {[  comma,              quotedbl,           dead_macron     ]};
    key <AB09>  {[  period,             ampersand,          hyphen          ]};
    key <AB10>  {[  eacute,             Eacute,             dead_acute      ]};

    key <SPCE>  {[  space,              space                               ]};
    key <CAPS>  {[  Caps_Lock,          Caps_Lock                           ]};

    include "level3(ralt_switch)"
};
