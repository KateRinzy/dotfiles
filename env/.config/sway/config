# Sway config adapted from Hyprland config

# Variables
set $mod Mod4

# Environment variables (set these in your shell or .profile)
# export XCURSOR_SIZE=24
# export XCURSOR_THEME=BreezeX-RosePine-Linux
# export LIBVA_DRIVER_NAME=nvidia
# export __GLX_VENDOR_LIBRARY_NAME=nvidia
# export NVD_BACKEND=direct
# export GBM_BACKEND=nvidia-drm
# export ELECTRON_OZONE_PLATFORM_HINT=auto
# export QT_QPA_PLATFORM=wayland
# export QT_QPA_PLATFORMTHEME=qt5ct
# export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
# export QT_AUTO_SCREEN_SCALE_FACTOR=1
# export QT_STYLE_OVERRIDE=kvantum
# export GDK_BACKEND=wayland,x11,*
# export SDL_VIDEODRIVER=wayland
# export CLUTTER_BACKEND=wayland
# export XDG_SESSION_TYPE=wayland
# export XDG_CURRENT_DESKTOP=Sway
# export XDG_SESSION_DESKTOP=Sway

exec ~/.config/hypr/scripts/setxkbmap.sh
exec ~/.config/waybar/waybar.sh

exec blueman-applet
exec ckb-next-daemon
exec dunst
exec fcitx5
exec nm-applet
exec swww-daemon
exec udiskie --tray
exec wl-paste --watch cliphist store --no-persist
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec dbus-update-activation-environment --systemd --all
exec systemctl --user import-environment QT_QPA_PLATFORMTHEME
exec systemctl --user start hyprpolkitagent
exec dbus-update-activation-environment --all
exec gnome-keyring-daemon --start --components=secrets

# Input settings
input * {
    xkb_layout ca
}

focus_follows_mouse yes

input type:touchpad {
    natural_scroll enabled
}

seat * {
    hide_cursor 15000
}

# Devices
input "wacom-one-by-wacom-m-pen" map_to_output HDMI-A-1

input "elan06fa:00-04f3:327e-touchpad" {
    # enabled
}

# Look and feel
gaps inner 0
gaps outer 0

default_border pixel 2
client.focused #C4A7E7 #C4A7E7 #1F1F28 #C4A7E7
client.unfocused #1F1F28 #1F1F28 #1F1F28 #1F1F28

# Layout: default tiling
smart_gaps on

# WM
bindsym $mod+c kill
bindsym $mod+F8 exit
bindsym $mod+Shift+q reload
bindsym $mod+Escape exec wlogout
bindsym $mod+l exec hyprlock
bindsym $mod+v floating toggle
bindsym $mod+j layout toggle split
bindsym $mod+f fullscreen
bindsym $mod+Shift+p move container to output right
bindsym Mod1+Tab workspace next
bindsym $mod+Tab workspace prev
bindsym $mod+b exec ~/.config/waybar/waybar.sh
bindsym $mod+F12 exec dunstctl history-pop

# Apps/Scripts
bindsym $mod+minus exec ~/.config/hypr/scripts/nvim-anywhere.sh
bindsym $mod+Ctrl+v exec cliphist list | rofi -dmenu -p "Clipboard" | cliphist decode | wl-copy
bindsym $mod+q exec alacritty
bindsym $mod+Return exec ghostty
bindsym $mod+w exec firefox
bindsym $mod+Page_Down exec kitty --class=calc tmux new-session qalc
bindsym $mod+r exec rofi -show drun -no-fixed-num-lines
bindsym $mod+y exec ~/.config/hypr/scripts/WallpaperSelect.sh
bindsym $mod+t exec dunstify "$(date)"
bindsym $mod+Shift+f exec thunar
bindsym $mod+s exec ~/.config/hypr/scripts/hyprshot.sh "simple"
bindsym Print exec ~/.config/hypr/scripts/hyprshot.sh "screen"
bindsym $mod+Shift+s exec ~/.config/hypr/scripts/hyprshot.sh
bindsym $mod+Shift+t exec ~/.config/hypr/scripts/get-text.sh
bindsym $mod+Shift+c exec hyprpicker -a
bindsym $mod+period exec rofi -modi emoji -show emoji -no-fixed-num-lines
bindsym $mod+dead_grave exec ~/.config/hypr/scripts/vim-scratch.sh zxcv
bindsym $mod+F10 exec ~/.config/hypr/scripts/vim-scratch.sh faire

# Workspaces
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9
bindsym $mod+0 workspace 10

# bindsym $mod+F1 exec ~/.config/hypr/scripts/spawn-if-empty.sh 6 thunderbird
# bindsym $mod+F2 workspace $ws07
# bindsym $mod+F3 exec ~/.config/hypr/scripts/spawn-if-empty.sh 8 spotify-launcher
# bindsym $mod+F4 exec ~/.config/hypr/scripts/spawn-if-empty.sh 9 vesktop

bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9
bindsym $mod+Shift+0 move container to workspace 10

bindsym $mod+Shift+F1 move container to workspace 6
bindsym $mod+Shift+F2 move container to workspace 7
bindsym $mod+Shift+F3 move container to workspace 8
bindsym $mod+Shift+F4 move container to workspace 9

bindsym --whole-window $mod+button4 workspace prev
bindsym --whole-window $mod+button5 workspace next

bindsym $mod+Left workspace prev
bindsym $mod+Right workspace next

bindsym $mod+Ctrl+Left workspace prev
bindsym $mod+Ctrl+Right workspace next
bindsym $mod+Shift+Left move container to workspace prev
bindsym $mod+Shift+Right move container to workspace next

# Window
bindsym $mod+h focus left
bindsym $mod+i focus right
bindsym $mod+e focus up
bindsym $mod+n focus down

bindsym $mod+Shift+h move left
bindsym $mod+Shift+n move down
bindsym $mod+Shift+e move up
bindsym $mod+Shift+i move right

bindsym $mod+Shift+k resize shrink height 20 px
bindsym $mod+Shift+m resize grow height 20 px

# bindsym --whole-window $mod+Ctrl+Btn1 move container
# bindsym --whole-window $mod+Shift+Ctrl+Btn1 resize container

# bindsym --whole-window $mod+Btn4 move left
# bindsym --whole-window $mod+Btn5 move right

# Sound and brightness
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+ && ~/.config/hypr/scripts/volume-dunst.sh
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%- && ~/.config/hypr/scripts/volume-dunst.sh
bindsym $mod+m exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && ~/.config/hypr/scripts/volume-dunst.sh

bindsym XF86MonBrightnessUp exec brightnessctl -e s 2%+
bindsym XF86MonBrightnessDown exec brightnessctl -e s 2%-

# Media control
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPause exec playerctl play-pause
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioPrev exec playerctl previous
bindsym XF86AudioMute exec playerctl play-pause
bindsym $mod+Page_Up exec ~/.config/hypr/scripts/change-sound-output.sh

# Window rules
for_window [class="calc"] floating enable
for_window [class="calc"] sticky enable
for_window [class="calc"] resize set width 70ppt height 50ppt

for_window [class="steam_app_1551360"] floating enable

for_window [class="Alacritty"] border pixel 5

for_window [class="org.pulseaudio.pavucontrol"] floating enable
for_window [class="org.pulseaudio.pavucontrol"] move position center
for_window [class="org.pulseaudio.pavucontrol"] resize set width 1000 px height 700 px

for_window [class="nvim-anywhere"] floating enable
for_window [class="nvim-anywhere"] resize set width 900 px height 300 px
for_window [class="nvim-anywhere"] move position center

for_window [title="Save.*"] floating enable
for_window [title="Save.*"] move position center
for_window [title="Save.*"] resize set width 1000 px height 700 px

# No focus for empty
# for_window [class="^$", title="^$"] border none

# Workspace assignments
assign [class="firefox"] 1

assign [class="com.mitchellh.ghostty"] 2

assign [title="Minecraft.*"] 4
assign [class="cs2"] 4
assign [class="worldofwarships64.exe"] 4
assign [class="forzahorizon5.exe"] 4
assign [class="overwatch.exe"] 4
assign [class="discovery.exe"] 4

assign [class="steam"] 5

assign [class="org.mozilla.Thunderbird"] 6

assign [class="spotify"] 8

assign [class="discord"] 9
assign [class="vesktop"] 9

# Workspace settings
workspace 1 output HDMI-A-1
workspace 2 output HDMI-A-1
workspace 3 output HDMI-A-1
workspace 4 output HDMI-A-1
workspace 5 output HDMI-A-1
workspace 6 output HDMI-A-1
workspace 7 output HDMI-A-1
workspace 8 output HDMI-A-1
workspace 9 output HDMI-A-1
workspace 10 output eDP-1

for_window [workspace=1] gaps inner 0 outer 0

# Special
assign [class="com.mitchellh.ghostty.scratch"] scratchpad
for_window [class="com.mitchellh.ghostty.scratch"] move scratchpad

# Monitors
output eDP-1 res 2560x1600@60Hz pos -2048 0 scale 1.25
output HDMI-A-1 res 1920x1080@120Hz pos 0 0 scale 1
