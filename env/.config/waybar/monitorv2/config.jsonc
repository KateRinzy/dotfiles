{
    "layer": "bottom",
    "position": "bottom",
    "output": "HDMI-A-1",
    "exclusive": true,
    "modules-left": [
        "hyprland/window"
    ],
    "hyprland/window": {
        "format": "{class}:{title}",
        "rewrite": {
            ":": "",
        }
    },
    "modules-right": [
        "tray",
        "custom/sep",
        "clock",
        "custom/sep"
    ],
    "custom/sep": {
        "format": " "
    },
    "clock": {
        "tooltip": true,
        "format": "{:%y%m%d::%H%M}"
    },
    "tray": {
        "icon-size": 8,
        "show-passive-items": "true"
    }
}
