{
    "layer": "bottom",
    "position": "bottom",
    "output": "HDMI-A-1",
    "exclusive": true,
    "modules-left": [
        "hyprland/window"
    ],
    "modules-center": [
        "mpris"
    ],
    "modules-right": [
        "tray",
        "custom/sep",
        "clock",
        "custom/sep"
    ],
    "hyprland/window": {
        "format": "{class}:{title}",
        "rewrite": {
            ":": "",
        }
    },
    "mpris": {
        "player": "spotify",
        "interval": 1,
        "format": "{status_icon}: {dynamic}",
        "format-paused": "{status_icon}: <i>{dynamic}</i>",
        "status-icons": {
            "default": "🎵",
            "paused": "⏸"
        }
    },
    "custom/sep": {
        "format": " "
    },
    "clock": {
        "tooltip": true,
        "format": "{:%y%m%d::%H%M}"
    },
    "tray": {
        "icon-size": 24,
        "show-passive-items": "true"
    }
}
