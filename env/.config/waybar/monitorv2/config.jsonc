{
    "layer": "bottom",
    "position": "bottom",
    "output": "HDMI-A-1",
    "exclusive": true,
    "modules-left": [
        "hyprland/window",
        "custom/sep",
        "hyprland/language"
    ],
    "modules-center": [
        "mpris"
    ],
    "modules-right": [
        "tray",
        "custom/sep",
        "cpu",
        "custom/sep",
        "memory",
        "custom/sep",
        "clock",
        "custom/sep"
    ],
    "hyprland/window": {
        "format": "[{class}]",
        "max-length": 50,
    },
    "hyprland/language": {
        "format": "[{}]"
    },
    "mpris": {
        "player": "spotify",
        "interval": 1,
        "format": "{status_icon}: {dynamic}",
        "format-paused": "{status_icon}: <i>{dynamic}</i>",
        "status-icons": {
            "default": "🎵",
            "paused": "⏸"
        }
    },
    "custom/sep": {
        "format": "   "
    },
    "clock": {
        "tooltip": true,
        "format": "{:%y:%m:%d - %H%M}"
    },
    "tray": {
        "icon-size": 12,
        "show-passive-items": "true"
    },
    "cpu": {
        "format": "CPU {}%",
        "tooltip": true,
        "tooltip-format": "CPU {}%",
        "interval": 2
    },

    "memory": {
        "format": "RAM {}%",
        "tooltip": true,
        "tooltip-format": "RAM {}%",
        "interval": 3
    },

}
