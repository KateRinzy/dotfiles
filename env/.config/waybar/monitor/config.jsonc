{
    "layer": "bottom",
    "position": "left",
    "output": "HDMI-A-1",
    "exclusive": true,
    "modules-left": [
        "hyprland/workspaces",
        "custom/sep"
    ],
    "modules-right": [
        "tray",
        "custom/sep",
        "clock",
        "custom/sep"
    ],
    "custom/sep": {
        "format": " "
    },
    "hyprland/workspaces": {
        "format": "{name}"
    },
    "clock": {
        "tooltip": true,
        "format": "{:%y\n%m\n%d\n::\n%H\n%M}"
    },
    "tray": {
        "icon-size": 12,
        "show-passive-items": "true"
    },
    "pulseaudio": {
        "format": "{volume}",
        "format-bluetooth": "{volume}%",
        "format-muted": "{volume}%",
        "format-icons": {
            "default": [
                "",
                ""
            ]
        },
        "scroll-step": 2,
        "on-click": "hyprctl dispatch exec pavucontrol",
        "on-click-right": "pactl set-source-mute @DEFAULT_SOURCE@ toggle"
    }
}
