{
    "layer": "top",
    "position": "bottom",
    "output": "eDP-1",
    "height": 32,
    "modules-left": [
        "hyprland/workspaces",
        "custom/sep",
        "hyprland/window",
        "custom/sep",
        "mpris"
    ],
    "modules-right": [
        "tray",
        "custom/sep",
        "cpu",
        "custom/sep",
        "memory",
        "custom/sep",
        "disk",
        "custom/sep",
        "pulseaudio",
        "custom/sep",
        "clock",
        "custom/sep",
        "battery",
        "custom/sep"
    ],
    "custom/sep": {
        "format": "   "
    },
    "mpris": {
        "player": "spotify",
        "max-length": 90,
        "interval": 1,
        "format": "[{position}/{length} - {artist} - {title}]",
        "format-paused": "<i>{dynamic}</i>",
    },
    "hyprland/workspaces": {
        "format": "[{name}]",
        "all-outputs": true
    },
    "hyprland/window": {
        "format": "[{class}]",
        "max-length": 50,
        "rewrite": {
            "[]": ""
        }
    },
    "hyprland/language": {
        "format": "[{}]"
    },
    "tray": {
        "icon-size": 24,
        "show-passive-items": "true"
    },
    "pulseaudio": {
        "format": "VOL [{volume}%]",
        "format-bluetooth": "VOL [ {volume}%]",
        "format-muted": "VOL []",
        "scroll-step": 2,
        "on-click": "hyprctl dispatch exec pavucontrol",
        "on-click-right": "pactl set-source-mute @DEFAULT_SOURCE@ toggle"
    },
    "clock": {
        "tooltip": true,
        "format": "TIME [{:%y:%m:%d - %H%M}]"
    },
    "battery": {
        "format": "BAT [{capacity}%]",
        "interval": 120
    },
    "cpu": {
        "format": "CPU [{}%]",
        "tooltip": true,
        "tooltip-format": "CPU {}%",
        "interval": 5
    },
    "memory": {
        "format": "RAM [{}%]",
        "tooltip": true,
        "tooltip-format": "RAM {}%",
        "interval": 5
    },
    "disk": {
        "format": "DISK [{percentage_used}%]",
        "interval": 360,
        "path": "/"
    }
}
