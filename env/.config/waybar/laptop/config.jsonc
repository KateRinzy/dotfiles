{
    "layer": "top",
    "position": "bottom",
    "output": "eDP-1",
    "height": 32,
    "modules-left": [
        "hyprland/workspaces",
        "custom/sep",
        "hyprland/window"
        // "custom/sep",
        // "mpris"
    ],
    "modules-center": [
        "mpris"
    ],
    "modules-right": [
        "tray",
        "custom/sep",
        "cpu",
        "custom/sep",
        "memory",
        "custom/sep",
        "pulseaudio",
        "custom/sep",
        "clock",
        "custom/sep",
        "battery",
        "custom/sep"
    ],
    "custom/sep": {
        "format": "   "
    },
    "mpris": {
        "player": "spotify",
        "max-length": 90,
        "interval": 1,
        "format": "[{position}/{length} - {artist} - {title}]",
        "format-paused": "<i>{dynamic}</i>",
    },
    "hyprland/workspaces": {
        "format": "[{name}]",
        "all-outputs": true
    },
    "hyprland/window": {
        "format": "[{class}]",
        "max-length": 50,
        "rewrite": {
            "[]": ""
        }
    },
    "hyprland/language": {
        "format": "[{}]"
    },
    "clock": {
        "tooltip": true,
        "format": "{:%y/%m/%d :: %H:%M}"
    },
    "tray": {
        "icon-size": 24,
        "show-passive-items": "true"
    },
    "pulseaudio": {
        "format": "{volume}",
        "format-bluetooth": " {volume}%",
        "format-muted": "",
        "scroll-step": 2,
        "on-click": "hyprctl dispatch exec pavucontrol",
        "on-click-right": "pactl set-source-mute @DEFAULT_SOURCE@ toggle"
    },
    "cpu": {
        "format": "CPU {}%",
        "tooltip": true,
        "tooltip-format": "CPU {}%",
        "interval": 5
    },
    "memory": {
        "format": "RAM {}%",
        "tooltip": true,
        "tooltip-format": "RAM {}%",
        "interval": 5
    },
}
