{
    "layer": "top",
    "position": "bottom",
    "height": 8,
    "spacing": 0,
    "modules-left": [
        "clock",
        "pulseaudio"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "tray"
    ],
    "hyprland/workspaces": {
        "format": "{}"
    },
    "clock": {
        "tooltip": true,
        "format": "{:%y/%m/%d %H:%M}   "
    },
    "tray": {
        "icon-size": 12,
        "show-passive-items": "true"
    },
    "pulseaudio": {
        "format": "{volume}",
        "format-bluetooth": "{volume}%",
        "format-muted": "{volume}%",
        "format-icons": {
            "default": [
                "",
                ""
            ]
        },
        "scroll-step": 2,
        "on-click": "hyprctl dispatch exec pavucontrol",
        "on-click-right": "pactl set-source-mute @DEFAULT_SOURCE@ toggle"
    }
}
