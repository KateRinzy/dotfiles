#!/usr/bin/env bash

tmp="$(mktemp)"

alacritty -e bash -lc "fd -e pdf | sort --reverse | fzf --no-sort -m >\"$tmp\""

if [ ! -s "$tmp" ]; then
  rm -f -- "$tmp"
  exit 1
fi

mapfile -t selected <"$tmp"
rm -f -- "$tmp"

[ "${#selected[@]}" -eq 0 ] && exit 1

paths=()
for f in "${selected[@]}"; do
  paths+=("$(realpath "$f")")
done

nohup zathura "${paths[@]}" >/dev/null 2>&1 &
