#!/usr/bin/env bash

set -euo pipefail

SRC_DIRS=("$HOME/repos" "$HOME/art")
DEST_DIR="/srv/git"

mkdir -p "$DEST_DIR" >/dev/null 2>&1
sudo rm -rf "$DEST_DIR"/* >/dev/null 2>&1

for SRC_DIR in "${SRC_DIRS[@]}"; do
  # Get a short name for the prefix (last part of path)
  prefix="$(basename "$SRC_DIR")"

  for repo in "$SRC_DIR"/*; do
    [ -d "$repo" ] || continue
    [ -d "$repo/.git" ] || continue

    name="$(basename "$repo")"
    dest_repo="$DEST_DIR/${prefix}-${name}.git"

    if [ -d "$dest_repo" ]; then
      continue
    fi

    git clone --bare "$repo" "$dest_repo" >/dev/null 2>&1
  done
done
